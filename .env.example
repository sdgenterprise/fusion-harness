# fusion-harness provider keys — copy to .env and fill in.
# `set dotenv-load := true` in the justfile exports these for every recipe.

# anthropic/* slots (e.g. claude-fable-5 architect)
ANTHROPIC_API_KEY=

# google/* slots — pi reads GEMINI_API_KEY for the google provider
# (NOT GOOGLE_GENERATIVE_AI_API_KEY).
GEMINI_API_KEY=

# fireworks/* slots (DeepSeek V4 Pro/Flash, Kimi K3, ...)
FIREWORKS_API_KEY=

# openai/* slots (gpt-5.6-sol / terra)
OPENAI_API_KEY=

# openrouter/* slots — also covers jev (extensions/jev): the decisions endpoint bills through OpenRouter
OPENROUTER_API_KEY=

# deepseek/* slots (direct api.deepseek.com — e.g. model-stack-direct.yaml architect)
DEEPSEEK_API_KEY=

# moonshotai/* slots (direct api.moonshot.ai — e.g. model-stack-direct.yaml Kimi K3 Main)
MOONSHOT_API_KEY=
